# PayHere Configuration
# PAYHERE_MERCHANT_ID must be the numeric merchant ID from your PayHere account
# (e.g. sandbox: 1216238  — found at sandbox.payhere.lk > Settings > Merchant ID)
# If this is left blank or non-numeric the backend returns a devBypass flag and
# the frontend activates the plan directly (safe for local development only).
PAYHERE_MERCHANT_ID=your_numeric_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true
PAYHERE_RETURN_URL=http://localhost:3000/dashboard/billing?status=success
PAYHERE_CANCEL_URL=http://localhost:3000/dashboard/billing?status=cancel
PAYHERE_NOTIFY_URL=http://localhost:5002/payhere/notify
